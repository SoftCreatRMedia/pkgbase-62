{
  "include": ["node_modules/@woltlab/d.ts/global.d.ts", "ts/**/*"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "rootDir": "ts/",
    "outDir": "files/js/",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "paths": {
      "*": ["./node_modules/@woltlab/d.ts/*"]
    },
    "noEmit": true,
    "importHelpers": true,
    "newLine": "lf"
  }
}
