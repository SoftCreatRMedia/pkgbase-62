    "@typescript/native": "npm:typescript@^7.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@woltlab/d.ts": "https://github.com/WoltLab/d.ts.git#25a3a5b5af84b3a1deeddb30d4d9680a32cf6e5f"
